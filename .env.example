# ==========================================
# AGY-KYC Checker Environment Configuration
# ==========================================

# Google Cloud & Vertex AI Settings
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_ACCOUNT=your-email@example.com
MODEL_ID=gemini-3.8-flash

# Ops Agent Dashboard Credentials
OPS_USERNAME=ops
OPS_PASSWORD=workshop2026
SESSION_SECRET_KEY=secret-key-workshop-2026-secure-token

# Thresholds for Biometric Matching (AdaFace Cosine Similarity)
# >= 0.65 -> MATCH / VERIFIED
# 0.45 - 0.64 -> MANUAL_REVIEW
# < 0.45 -> FRAUD / REJECTED
BIOMETRIC_MATCH_THRESHOLD=0.65
BIOMETRIC_REVIEW_THRESHOLD=0.45

# Mock Mode (Set to 1 to force offline/mock mode for test environments)
MOCK_MODE=0
